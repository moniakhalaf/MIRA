# MIRA backend — Edge Function secrets
# Copy to your notes, fill in real values, then load them with:
#   supabase secrets set KEY=value KEY=value ...
# NEVER commit real values. NEVER put service_role or the Stripe secret key
# in the client app — they belong only here (server-side).

# ── Stripe ──────────────────────────────────────────────────────────────
# Start with test-mode keys (sk_test_…) and test price IDs.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx        # from Stripe → Developers → Webhooks
STRIPE_PRICE_PRO=price_xxx             # Pro  ($6.99/mo) recurring price ID
STRIPE_PRICE_TEAM=price_xxx            # Team ($19.99/mo) recurring price ID

# ── App ─────────────────────────────────────────────────────────────────
SITE_URL=https://your-domain           # where Stripe redirects after checkout

# ── Supabase ────────────────────────────────────────────────────────────
# From Supabase → Project Settings → API.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...               # safe to expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJ...       # SERVER ONLY — never ship to the client
